
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neomaredi-com",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "neomaredi.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "WRITING_MODE": "static"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  }
}
